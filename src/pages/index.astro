---
import Layout from '../layouts/Layout.astro';
import { cv } from '../data/cv';

// Landing-page links. The CV keeps its own, fuller set in src/data/cv.ts.
const groups = [
  { label: 'LinkedIn', links: [{ text: 'linkedin.com/in/binarycat', href: 'https://linkedin.com/in/binarycat' }] },
  { label: 'GitHub', links: [{ text: 'github.com/binarycat0', href: 'https://github.com/binarycat0' }] },
  { label: 'Medium', links: [{ text: 'medium.com/@artur.rakhmatulin', href: 'https://medium.com/@artur.rakhmatulin' }] },
  { label: 'CV', links: [{ text: '/cv.html', href: '/cv.html' }] },
  { label: 'Projects', links: [{ text: 'demo.binaryc.at', href: 'https://demo.binaryc.at' }] },
  {
    label: 'Tools',
    links: [
      { text: 'tools.binaryc.at', href: 'https://tools.binaryc.at/' },
      { text: 'watchcat', href: 'https://tools.binaryc.at/watchcat/' },
      { text: 'buildyard', href: 'https://tools.binaryc.at/buildyard/' },
    ],
  },
];
---

<Layout title={cv.name} description={`${cv.title} based in ${cv.location}.`}>
  <div class="home">
    <img class="portrait" src="/photo.jpg" alt={cv.name} width="128" height="128" />

    <h1>{cv.name}</h1>
    <p class="tagline">{cv.title}<span class="sep">·</span>{cv.location}</p>

    <nav class="home-links">
      <dl>
        {
          groups.map((group) => (
            <>
              <dt>{group.label}</dt>
              <dd>
                <ul>
                  {group.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        rel={link.href.startsWith('/') ? null : 'me noopener'}
                      >
                        {link.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </dd>
            </>
          ))
        }
      </dl>
    </nav>
  </div>
</Layout>
