---
import Layout from '../layouts/Layout.astro';
import ResourceList from '../components/ResourceList.astro';
import { cv } from '../data/cv';

const year = new Date().getFullYear();
const description = cv.summary[0];

/** "https://www.dremio.com/" -> "dremio.com" */
const displayHost = (href: string) =>
  new URL(href).hostname.replace(/^www\./, '');
---

<Layout title={`${cv.name} — ${cv.title}`} description={description}>
  <div class="page">
    <header class="masthead">
      <h1>{cv.name}</h1>
      <p class="tagline">
        {cv.title}<span class="sep">·</span>{cv.location}
      </p>

      {cv.summary.map((para) => <p class="summary">{para}</p>)}

      <ul class="contact">
        <li><a href={`mailto:${cv.email}`}>{cv.email}</a></li>
        {
          cv.phone && (
            <li>
              <a href={`tel:${cv.phone.replace(/\s/g, '')}`}>{cv.phone}</a>
            </li>
          )
        }
        {
          cv.links.map((link) => (
            <li>
              <a href={link.href} rel="me noopener">
                {link.display ?? link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    <main>
      <section class="section" aria-labelledby="skills">
        <h2 id="skills">Skills</h2>
        <dl class="skills">
          {
            cv.skills.map((group) => (
              <>
                <dt>{group.label}</dt>
                <dd>{group.items.join(', ')}</dd>
              </>
            ))
          }
        </dl>
      </section>

      <section class="section" aria-labelledby="experience">
        <h2 id="experience">Experience</h2>
        {
          cv.experience.map((role) => (
            <article class="entry">
              <div class="entry-head">
                <h3>
                  {role.title} <span class="at">at</span> {role.company}{' '}
                  {role.companyHref && (
                    <span class="company-url">
                      (
                      <a href={role.companyHref} rel="noopener">
                        {displayHost(role.companyHref)}
                      </a>
                      )
                    </span>
                  )}
                </h3>
                <span class="dates">
                  {role.start}&nbsp;–&nbsp;{role.end ?? 'present'}
                </span>
              </div>

              {role.location && <p class="entry-meta">{role.location}</p>}

              <ul class="highlights">
                {role.highlights.map((item) => (
                  <li>
                    {item.text}
                    {item.children && item.children.length > 0 && (
                      <ul class="highlights sub">
                        {item.children.map((child) => (
                          <li>{child}</li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </section>

      {
        cv.projects.length > 0 && (
          <section class="section" aria-labelledby="projects">
            <h2 id="projects">Projects</h2>
            <ResourceList items={cv.projects} />
          </section>
        )
      }

      <section class="section" aria-labelledby="open-source">
        <h2 id="open-source">Open source</h2>
        <ResourceList items={cv.openSource} />
      </section>

      <section class="section" aria-labelledby="publications">
        <h2 id="publications">Publications</h2>
        <ResourceList items={cv.publications} />
      </section>

      <section class="section" aria-labelledby="education">
        <h2 id="education">Education</h2>
        {
          cv.education.map((entry) => (
            <article class="entry">
              <div class="entry-head">
                <h3>{entry.credential}</h3>
                {entry.start && (
                  <span class="dates">
                    {entry.start}
                    {entry.end && <>&nbsp;–&nbsp;{entry.end}</>}
                  </span>
                )}
              </div>
              <p class="entry-meta">{entry.institution}</p>
            </article>
          ))
        }
      </section>

      <section class="section" aria-labelledby="languages">
        <h2 id="languages">Languages</h2>
        <dl class="skills">
          {
            cv.languages.map((language) => (
              <>
                <dt>{language.name}</dt>
                <dd>{language.level}</dd>
              </>
            ))
          }
        </dl>
      </section>
    </main>

    <footer class="colophon">
      <span>© {year} {cv.name}</span>
      <span class="no-print">Press ⌘P / Ctrl-P for a PDF copy.</span>
    </footer>
  </div>
</Layout>
