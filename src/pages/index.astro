---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { cv } from '../data/cv';
import type { IconName } from '../icons';

interface Row {
  label: string;
  icon: IconName;
  links: { text: string; href: string; lang?: string }[];
}

// Landing-page links. The CV keeps its own, fuller set in src/data/cv.ts.
const groups: Row[] = [
  { label: 'LinkedIn', icon: 'linkedin', links: [{ text: 'linkedin.com/in/binarycat', href: 'https://linkedin.com/in/binarycat' }] },
  { label: 'GitHub', icon: 'github', links: [{ text: 'github.com/binarycat0', href: 'https://github.com/binarycat0' }] },
  { label: 'Medium', icon: 'medium', links: [{ text: 'medium.com/@artur.rakhmatulin', href: 'https://medium.com/@artur.rakhmatulin' }] },
  {
    label: 'CV',
    icon: 'cv',
    links: [
      { text: 'resume', href: '/cv' },
      { text: 'резюме', href: '/ru/cv', lang: 'ru' },
    ],
  },
  {
    label: 'Projects',
    icon: 'projects',
    links: [
      { text: 'ymove.org', href: 'https://ymove.org/' },
      { text: 'demo.binaryc.at', href: 'https://demo.binaryc.at' },
    ],
  },
  {
    label: 'Tools',
    icon: 'tools',
    links: [
      { text: 'tools.binaryc.at', href: 'https://tools.binaryc.at/' },
    ],
  },
];
---

<Layout title={cv.name} description={`${cv.title} based in ${cv.location}.`}>
  <div class="home">
    <img class="portrait" src="/photo.jpg" alt={cv.name} width="128" height="128" />

    <h1>{cv.name}</h1>
    <p class="tagline">{cv.title}<span class="sep">·</span>{cv.location}</p>

    <nav class="home-links">
      <dl>
        {
          groups.map((group) => (
            <>
              <dt>
                <Icon name={group.icon} />
                <span class="visually-hidden">{group.label}</span>
              </dt>
              <dd>
                <ul>
                  {group.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        lang={link.lang}
                        rel={link.href.startsWith('/') ? null : 'me noopener'}
                      >
                        {link.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </dd>
            </>
          ))
        }
      </dl>
    </nav>
  </div>
</Layout>
